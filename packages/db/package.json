{
  "name": "@deepcode/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@deepcode/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "node --conditions=@deepcode/source --env-file-if-exists=../../.env --import tsx src/scripts/migrate.ts",
    "seed": "node --conditions=@deepcode/source --env-file-if-exists=../../.env --import tsx src/scripts/seed.ts",
    "go:free": "node --conditions=@deepcode/source --env-file-if-exists=../../.env --import tsx src/scripts/goFree.ts",
    "go:plans": "node --conditions=@deepcode/source --env-file-if-exists=../../.env --import tsx src/scripts/goPlans.ts",
    "roles": "node --conditions=@deepcode/source --env-file-if-exists=../../.env --import tsx src/scripts/roles.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepcode/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.14.0",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
