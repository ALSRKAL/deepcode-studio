{
  "name": "@deepcode/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@deepcode/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@deepcode/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./node/keys": {
      "@deepcode/source": "./src/node/virtualKeys.ts",
      "types": "./dist/node/virtualKeys.d.ts",
      "default": "./dist/node/virtualKeys.js"
    },
    "./node/pool-crypto": {
      "@deepcode/source": "./src/node/poolKeyCrypto.ts",
      "types": "./dist/node/poolKeyCrypto.d.ts",
      "default": "./dist/node/poolKeyCrypto.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
