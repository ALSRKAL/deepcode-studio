# Copy to .env for local development. Never commit real values.
# Matrix and classification: docs/plan/00-MASTER-ARCHITECTURE.md §6

# --- shared server secrets (gateway + web) ---
DATABASE_URL=postgres://deepcode:deepcode@127.0.0.1:55432/deepcode
REDIS_URL=redis://127.0.0.1:56379
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
POOL_KEY_ENCRYPTION_KEY=
# 32 random bytes, base64. HMAC pepper for virtual-key hashing.
KEY_HASH_PEPPER=
# Shared token for web -> gateway /internal calls.
GATEWAY_INTERNAL_TOKEN=

# --- gateway ---
GATEWAY_PORT=8790
# Optional second listener serving Prometheus metrics without auth.
# Bind it to the private network only (it is never exposed by the app itself).
#GATEWAY_METRICS_PORT=8791
GATEWAY_PUBLIC_WEB_ORIGIN=http://localhost:3000
UPSTREAM_STREAM_HEADERS_TIMEOUT_MS=30000
UPSTREAM_REQUEST_TIMEOUT_MS=120000
# Behind a reverse proxy that APPENDS the client address to X-Forwarded-For, set
# TRUST_PROXY=true (and TRUSTED_PROXY_HOPS to the number of such proxies). Rate
# limits then key on the right-most entry. Without it, per-IP limits are not used.
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
LOG_LEVEL=info

# --- seed only (pnpm db:seed) ---
# Optional comma-separated OpenCode Go API keys to load into the pool (encrypted at rest).
SEED_POOL_KEYS=

# --- web (apps/web) ---
# Public origin of the portal and the gateway URL shown to clients.
APP_URL=http://localhost:3210
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8790
# Session signing secret (32+ random bytes, base64).
AUTH_SECRET=
# mock | stripe (owner decision 2; Stripe TEST MODE only, never live keys)
BILLING_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# HMAC secret for the local mock-billing webhook.
MOCK_BILLING_WEBHOOK_SECRET=
# Local Mailpit SMTP (infra compose). Unset => mail is printed to the console.
SMTP_URL=smtp://127.0.0.1:55125
MAIL_FROM=no-reply@deepcode.example
# base64 PKCS#8 Ed25519 key signing the Skills/MCP sync manifest.
MANIFEST_SIGNING_KEY=
MANIFEST_KEY_ID=deepcode-sync-1
# Server-side storage for skill archives (never web-served statically).
STORAGE_DIR=.storage
# Admin panel demands TOTP 2FA (disable only for local tests).
ADMIN_2FA_REQUIRED=true

# --- Payments: UPI QR + manual approval (docs/deploy/README.ar.md) ---------------
# BILLING_PROVIDER=upi
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=DeepCode Studio
UPI_PAYMENT_TTL_HOURS=48
# Firebase project of the admin phone app (same values as smm/.env.local).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
ADMIN_PUSH_TOPIC=admins

# --- Free-tier tuning (gateway) ----------------------------------------------------
POOL_RELOAD_INTERVAL_MS=15000
CATALOG_RELOAD_INTERVAL_MS=60000
