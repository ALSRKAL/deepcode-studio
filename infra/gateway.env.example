# Gateway service environment for the local staging stack.
# Do not fill this in by hand: run `infra/gen-staging-env.sh`, which writes the
# gitignored `infra/gateway.env` with correctly sized random values.
#
# POOL_KEY_ENCRYPTION_KEY=base64 of exactly 32 bytes (AES-256-GCM)
# KEY_HASH_PEPPER=base64 of at least 32 bytes (HMAC pepper, shared with web)
# GATEWAY_INTERNAL_TOKEN=at least 32 characters (shared with web)
