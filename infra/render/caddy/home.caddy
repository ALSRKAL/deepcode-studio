# Home mode (your PC behind Tailscale Funnel): serve everything.
# Funnel is the public edge, so there is no shared-secret gate: the app's own
# authentication protects every page and the gateway still requires API keys.
{
	admin off
	auto_https off
	# The platform terminates TLS in front of us.
	servers {
		protocols h1 h2c
		# Tailscale Funnel connects from loopback and sets X-Forwarded-Proto: https;
		# trust it so the apps behind us see the public scheme, not http.
		trusted_proxies static private_ranges
	}
}

:{$PORT:10000} {
	# Tailscale Funnel rewrites X-Forwarded-Host to the tailnet name; the app builds
	# redirects from it, so a bare "/pricing" sent visitors to the wrong host. This
	# server only ever serves the public site, so state its public host explicitly.
	request_header X-Forwarded-Host {$PUBLIC_HOST}
	request_header X-Forwarded-Proto https
	import /app/caddy/routes.caddy
}
