# The app's routes (gateway, phone relay, website); imported by every mode.
# Which machine answered (home = your PC, cloud = Render): visible in browser dev tools.
header X-DeepCode-Server {$DEEPCODE_SERVER_NAME:cloud}

# Never compress the gateway's streams (they must flush event by event).
@compressible not path /v1/* /v1beta/*
encode @compressible gzip

@gateway path /v1/* /v1beta/* /healthz /readyz
handle @gateway {
	reverse_proxy 127.0.0.1:8790 {
		flush_interval -1
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}
}

# Phone remote control relay (apps/desktop/packages/relay): the desktop and the phone
# both connect out to it, so it works on any network. Page at /remote/, socket at /remote/ws.
redir /remote /remote/ 308
handle_path /remote/* {
	reverse_proxy 127.0.0.1:8443 {
		flush_interval -1
		transport http {
			read_timeout 24h
			write_timeout 24h
		}
	}
}

# Internal and metrics endpoints are only for processes inside this container.
@internal path /internal/* /metrics
handle @internal {
	respond 404
}

handle {
	reverse_proxy 127.0.0.1:3000
}
