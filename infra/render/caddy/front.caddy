# Front mode (Render): send traffic to the home server (HOME_ORIGIN) while it is healthy,
# otherwise serve it here. Both upstreams are checked every few seconds; the public
# address, cookies and the desktop app's settings stay the same either way.
{
	admin off
	auto_https off
	# The platform terminates TLS in front of us.
	servers {
		protocols h1 h2c
		# Render's load balancer (private range) sets X-Forwarded-Proto: https;
		# trust it so the apps behind us see the public scheme, not http.
		trusted_proxies static private_ranges
	}
}

:{$PORT:10000} {
	# Phone remote control: the relay keeps pairings in memory, so the desktop and the phone
	# must reach the SAME copy. Always serve it here, never on the home server; otherwise a
	# desktop that connected while the PC was down and a phone that connects later land on
	# different relays and the phone sees no conversations (fixed 2026-11-18).
	handle /remote* {
		reverse_proxy 127.0.0.1:10001 {
			flush_interval -1
			transport http {
				read_timeout 24h
				write_timeout 24h
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:10002 127.0.0.1:10001 {
			lb_policy first
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 20s
			# Funnel answers 502 itself when the PC's server is down: count that as a failure
			# at once instead of waiting for the next active check.
			unhealthy_status 502 503 504
			health_uri /readyz
			health_interval 5s
			health_timeout 4s
			health_passes 2
			health_fails 1
			flush_interval -1
			transport http {
				read_timeout 24h
				write_timeout 24h
			}
		}
	}
}

# Local copy of the app (fallback).
# Port-only sites (any Host header), reachable only inside the container.
http://:10001 {
	bind 127.0.0.1
	import /app/caddy/routes.caddy
}

# The home server, reached over HTTPS through Tailscale Funnel (HOME_URL is set by start.sh).
http://:10002 {
	bind 127.0.0.1
	reverse_proxy {$HOME_URL} {
		header_up Host {upstream_hostport}
		header_up X-DeepCode-Edge {$HOME_EDGE_TOKEN}
		flush_interval -1
		transport http {
			dial_timeout 3s
			read_timeout 24h
			write_timeout 24h
		}
	}
}
