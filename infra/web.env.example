# Web service environment for the local staging stack.
# Do not fill this in by hand: run `infra/gen-staging-env.sh`, which writes the
# gitignored `infra/web.env` with correctly sized random values.
#
# POOL_KEY_ENCRYPTION_KEY=base64 of exactly 32 bytes (write-only encryption)
# KEY_HASH_PEPPER=base64 of at least 32 bytes (must equal the gateway value)
# GATEWAY_INTERNAL_TOKEN=at least 32 characters (must equal the gateway value)
# AUTH_SECRET=at least 32 characters (better-auth)
# MOCK_BILLING_WEBHOOK_SECRET=hex string (local mock webhook HMAC)
# MANIFEST_SIGNING_KEY=base64 PKCS#8 Ed25519 private key (manifest item signatures)
