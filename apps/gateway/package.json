{
  "name": "@deepcode/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=@deepcode/source --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepcode/db": "workspace:*",
    "@deepcode/shared": "workspace:*",
    "@hono/node-server": "1.19.19",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "ioredis": "5.11.1",
    "postgres": "3.4.9",
    "prom-client": "^15.1.3",
    "undici": "7.30.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.14.0",
    "@testcontainers/redis": "11.14.0",
    "@types/node": "24.19.2",
    "testcontainers": "11.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
