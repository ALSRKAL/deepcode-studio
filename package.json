{
  "name": "deepcode-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint apps/gateway packages && pnpm --filter @deepcode/web lint",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @deepcode/db generate",
    "db:migrate": "pnpm --filter @deepcode/db migrate",
    "db:seed": "pnpm --filter @deepcode/db seed",
    "db:go-free": "pnpm --filter @deepcode/db go:free",
    "dev:gateway": "pnpm --filter @deepcode/gateway dev",
    "verify:synthetic": "node --env-file-if-exists=.env scripts/verify-synthetic-live.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxlint": "1.93.0",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "postcss": "8.5.33"
    }
  }
}
